{
  "name": "campus-plant-zone-manager",
  "version": "0.4.0",
  "description": "校园植物分区管理系统（支持自定义底图、项目目录持久化、中文/英文界面）",
  "main": "main.js",
  "author": "YU GangZuo",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cqnu.plantmap",
    "productName": "校园植物分区管理系统",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": [
        "CQNU"
      ],
      "legalTrademarks": "CQNU"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "校园植物分区管理系统"
    },
    "copyright": "Copyright © YU GangZuo"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "adm-zip": "^0.5.16"
  }
}