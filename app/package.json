{
  "name": "campus-plant-zone-manager",
  "version": "9.0.1",
  "description": "校园植物分区管理系统（支持自定义底图、项目目录持久化、中文/英文界面）",
  "main": "main.js",
  "author": "YUGANG Zuo",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,css,html,json}\"",
    "self-check": "node scripts/self-check.js",
    "check:size": "node scripts/check-file-size.js",
    "check:syntax": "node scripts/check-js-syntax.js",
    "check:repo": "node scripts/check-repo-hygiene.js",
    "verify": "npm run check:repo && npm run check:syntax && npm run check:size && npm run self-check",
    "check": "npm run lint && npm run self-check",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test": "npm run test:unit && npm run test:integration",
    "sqlite:probe": "electron scripts/sqlite-dependency-probe.js",
    "sqlite:probe:electron": "electron scripts/sqlite-dependency-probe.js",
    "sqlite:probe:node": "node scripts/sqlite-dependency-probe.js",
    "db:check-schema": "electron scripts/check-sqlite-schema.js",
    "db:test-conversion": "electron scripts/test-sqlite-conversion.js",
    "db:test-storage-conversion": "electron scripts/test-storage-conversion.js"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "build": {
    "appId": "com.cqnu.plantmap",
    "productName": "校园植物分区管理系统",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "src/**/*",
      "scripts/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": [
        "CQNU"
      ],
      "legalTrademarks": "CQNU",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "校园植物分区管理系统",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "copyright": "Copyright © YUGANG Zuo"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.10.0",
    "exifr": "^7.1.3"
  }
}
