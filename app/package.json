{
  "name": "campus-plant-zone-manager",
  "version": "1.1.0-beta.2",
  "description": "校园植物分区管理系统，支持本地项目、植物记录、物候归档与研究统计。",
  "main": "main-dist/main/index.js",
  "author": "YUGANG Zuo",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:electron": "npm run build:main && npm run build:preload",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "presmoke:renderer": "npm run build",
    "smoke:renderer": "electron scripts/renderer-smoke.js",
    "presmoke:web": "npm run build:renderer && npm --prefix ../site run build",
    "smoke:web": "electron scripts/web-workspace-smoke.js",
    "previsual:check": "npm run build:renderer && npm --prefix ../site run build",
    "visual:check": "node scripts/visual-regression-runner.js check",
    "previsual:update": "npm run build:renderer && npm --prefix ../site run build",
    "visual:update": "node scripts/visual-regression-runner.js update",
    "prestart": "npm run build",
    "start": "electron .",
    "prestart:web": "npm run build:renderer",
    "start:web": "node scripts/web-preview.js",
    "predist": "npm run build",
    "dist": "electron-builder --win nsis --config.electronDist=node_modules/electron/dist",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,html,json,md,yml,yaml}\"",
    "preself-check": "npm run build:main",
    "self-check": "node scripts/self-check.js",
    "self-check:core": "node scripts/self-check.js",
    "check:bundle": "node scripts/check-client-bundle.js",
    "check:size": "node scripts/check-file-size.js",
    "check:syntax": "node scripts/check-js-syntax.js",
    "check:repo": "node scripts/check-repo-hygiene.js",
    "check:version": "node scripts/check-release-version.js",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck:electron && npm run typecheck:renderer",
    "ci:install": "npm ci --ignore-scripts --no-audit --fund=false",
    "verify": "npm run check:repo && npm run check:version && npm run check:syntax && npm run typecheck && npm run build && npm run check:bundle && npm run check:size && npm run self-check:core",
    "install:electron": "node node_modules/electron/install.js",
    "rebuild:electron": "electron-builder install-app-deps",
    "prepare:electron": "npm run install:electron && npm run rebuild:electron",
    "check": "npm run lint && npm run self-check",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-isolation=none tests/unit/*.test.js",
    "test:integration": "node --test --test-isolation=none tests/integration/*.test.js",
    "test": "npm run test:unit && npm run test:integration",
    "sqlite:probe": "electron scripts/sqlite-dependency-probe.js",
    "sqlite:probe:electron": "electron scripts/sqlite-dependency-probe.js",
    "sqlite:probe:node": "node scripts/sqlite-dependency-probe.js",
    "db:check-schema": "electron scripts/check-sqlite-schema.js",
    "db:test-conversion": "electron scripts/test-sqlite-conversion.js",
    "db:test-storage-conversion": "electron scripts/test-storage-conversion.js",
    "db:test-runtime": "electron scripts/test-sqlite-runtime-acceptance.js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.13.3",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  },
  "build": {
    "appId": "com.cqnu.plantmap",
    "productName": "校园植物分区管理系统",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main-dist/**/*",
      "index.html",
      "style.css",
      "renderer-dist/**/*",
      "src/**/*",
      "scripts/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": {
        "publisherName": [
          "CQNU"
        ]
      },
      "legalTrademarks": "CQNU",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "校园植物分区管理系统",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "copyright": "Copyright © YUGANG Zuo"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.10.0",
    "exifr": "^7.1.3",
    "fflate": "0.8.2",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lucide-preact": "^1.27.0",
    "motion": "^13.1.1",
    "preact": "^10.29.7"
  }
}
